# Environment Variables Configuration
# Copy this file to .env before starting the system

# Backend Security (Required)
JWT_SECRET=super-secret-key-change-me-in-production-1234567890

# Optional Database Overrides (Defaults work out of the box with Docker)
# MONGO_URI=mongodb://mongodb:27017/visioninspect
# DATABASE_URL=sqlite:////app/data/inspection.db

# Optional Admin Bootstrap (If you want default users created)
BOOTSTRAP_ADMIN_EMAIL=admin@visionguard.local
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_SUPERVISOR_EMAIL=supervisor@visionguard.local
BOOTSTRAP_SUPERVISOR_PASSWORD=supervisor123
