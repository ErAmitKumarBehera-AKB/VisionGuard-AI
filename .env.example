# ==============================================================================
# Environment Configuration - Visual Quality Inspection System
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Machine Learning & Data Paths
MVTEC_DATA_DIR=ml/data/raw/mvtec
CASTING_DATA_DIR=ml/data/raw/casting
DATASET_MANIFEST_PATH=ml/data/manifests/unified_manifest.parquet
MODEL_CHECKPOINT_PATH=ml/artifacts/checkpoints/best_model.pt
MODEL_EXPORT_DIR=ml/artifacts/exported

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=manufacturing-defect-inspection

# BentoML Model Serving
BENTOML_HOST=0.0.0.0
BENTOML_PORT=3000
BENTOML_SERVICE_URL=http://localhost:3000

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend/app/inspection.db
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501","*"]

# Streamlit QC Interface
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Edge Device (Raspberry Pi 5)
EDGE_DEVICE_ID=rpi5-edge-01
CAMERA_INDEX=0
EDGE_CONFIDENCE_THRESHOLD=0.85
ACTUATOR_PIN=18
SENSOR_TRIGGER_PIN=24

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
